# 기존 .env와 호환. 이 파일을 .env로 복사하고 chmod 600 .env 하세요.
USERNAME=YOURID
PASSWORD=YOUR_PASSWORD
# 로또 게임 수 (1~5). 연금복권은 기존과 같이 같은 번호 1~5조 총 5매.
COUNT=5

# 선택 사항. 기존 Telegram sendMessage URL(chat_id 포함) 사용 가능.
TELEGRAM_WEBHOOK_URL=

# 실행 디렉터리 기준 상태 저장 경로. 모든 실행이 같은 경로를 써야 합니다.
STATE_DIR=.state
# 전체 동행복권 도메인/리다이렉트에 공통 적용. 최소 5초 + 무작위 0.1~1초.
REQUEST_INTERVAL_SECONDS=5
